---
import '@fontsource/fraunces/latin-400.css';
import '@fontsource/fraunces/latin-400-italic.css';
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import '../styles/book.css';
import '../styles/edition.css';
import MagazinePages from '../components/MagazinePages.astro';
import { chapters } from '../data/edition';
import EditorialCat from '../components/EditorialCat.astro';

---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#e8e1d6" />
  <meta name="description" content="Abre la revista de Don Bigotón y descubre, página a página, una historia de cocina, familia y emprendimiento." />
  <meta property="og:type" content="article" /><meta property="og:locale" content="es_EC" /><meta property="og:title" content="Don Bigotón — La sazón de volver a empezar" /><meta property="og:description" content="Una revista para pasar las páginas y conocer la historia detrás de la sazón." /><meta property="og:image" content={new URL('/social-cover.jpg',Astro.site||Astro.url).href} /><meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />{Astro.site&&<link rel="canonical" href={Astro.site.href}/>}<title>Don Bigotón — Una historia con sazón propia</title>
</head>
<body>
  <header class="reader-header"><a href="/" class="reader-brand">don bigotón<span aria-hidden="true">✳</span></a><span class="reader-edition">LA SAZÓN DE VOLVER A EMPEZAR <i>—</i> EDICIÓN 01</span><div class="reader-tools"><a href="/revista-don-bigoton.pdf" download>Descargar PDF ↓</a><button id="index-toggle" aria-expanded="false" aria-controls="book-index">Índice <span>☰</span></button></div></header>
  <nav class="book-index" id="book-index" aria-label="Ir a un capítulo" hidden><div class="index-top"><span>EN ESTA EDICIÓN</span><button id="index-close" aria-label="Cerrar índice">×</button></div>{chapters.map(({title,page})=><button data-goto={Number(page)-1}><span>{String(page).padStart(2,'0')}</span><strong>{title}</strong><span>↗</span></button>)}<a href="/lectura/">Prefiero leer de forma continua ↗</a></nav>
  <main class="reader-main" id="reader-main">
    <p class="reader-hint" id="reader-hint"><span aria-hidden="true">↳</span> Abre la revista. Hay una historia detrás de cada sabor.</p>
    <div class="book-viewport" id="book-viewport"><div id="book" class="book" aria-label="Revista digital Don Bigotón, 10 páginas">
      <MagazinePages/>
    </div></div>
  </main>
  <footer class="reader-controls"><div class="reader-bottom"><button id="cover-button" data-goto="0">DON BIGOTÓN <span>/ REVISTA DIGITAL</span></button><div class="page-navigation"><button id="prev-page" aria-label="Página anterior" disabled>←</button><output id="page-status" aria-live="polite" aria-atomic="true">PORTADA / 10</output><button id="next-page" aria-label="Página siguiente">→</button></div><div class="reader-extra"><EditorialCat /><button id="zoom-toggle" aria-pressed="false" title="Ampliar revista">Ampliar ＋</button><span id="reading-mode">DOBLE PÁGINA</span></div></div><label class="page-slider"><span class="sr-only">Ir a una página</span><input id="page-slider" type="range" min="1" max="10" value="1" aria-label="Ir a una página"/></label></footer>
  <noscript><p class="no-script">Puedes leer todas las páginas a continuación o abrir la <a href="/lectura/">versión continua</a>.</p></noscript>
  <script>import '../scripts/book';</script>
</body>
</html>
