---
interface Props {theme:'resources'|'relationships'|'future';number:number;}
const {theme,number}=Astro.props;
const ink=`illustrated-ink-${number}`;
---
<g class={'illustrated-border illustrated-'+theme} stroke-linecap="round" stroke-linejoin="round">
  <defs><linearGradient id={ink} x1="0" y1="0" x2="1080" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="#edc381"/><stop offset=".48" stop-color="#eac18b"/><stop offset=".57" stop-color="#bd744b"/><stop offset="1" stop-color="#af5e3d"/></linearGradient></defs>
  {theme==='resources'&&<g stroke={`url(#${ink})`} stroke-width="1.35">
    <path d="M18 650C2 658 8 674 29 690Q39 702 54 699C75 694 91 686 111 690C130 694 120 710 109 704C97 697 111 685 128 688C151 692 163 698 181 697C209 695 231 689 252 695S297 704 317 697C335 690 350 691 344 700C337 708 325 695 338 687C355 676 378 700 405 704C442 713 490 711 514 698C532 688 541 676 530 672C513 666 512 686 535 695C552 702 573 682 557 681C544 680 539 700 557 704C578 714 604 698 629 701S676 710 708 703S755 699 785 704S828 711 859 703S903 699 935 703S979 709 1009 703Q1027 701 1043 699Q1072 697 1069 668"/>
    <g transform="translate(42 697) rotate(-32) scale(1.15)"><path d="M-1.5 0v-21Q-12-44 0-44Q12-44 1.5-21V0Q0 3-1.5 0Z"/><path d="M0-22Q-7-44 0-44Q7-44 0-22Zm0 0v-22"/></g>
    <g transform="translate(67 698) rotate(27) scale(1.13)"><path d="M-1.5 0v-22h-5v-20h13v20h-5V0Z"/><path d="M-3-38v12m3-12v12m3-12v12"/></g>
    <g fill="#edbd91" stroke-width=".8"><path d="m173 693 14-4 20 14-8 9-21-10Z"/><path d="m779 701 11-8 19 9-12 17-13-8Z"/><circle cx="184" cy="695" r="1.5" fill="#b16541"/><circle cx="789" cy="700" r="1.5" fill="#b16541"/></g>
    <g stroke="#b16541"><ellipse cx="1013" cy="685" rx="10" ry="3.5"/><path d="M1003 685v12c0 5 20 5 20 0v-12m-20 5c0 5 20 5 20 0m-20 4c0 5 20 5 20 0"/><path d="m1042 708-4-38 28-3 5 38-29 3Zm3-32 17-2m-16 9 17-2m-16 9 17-2m-16 9 17-2"/><path class="border-glint" d="M1042 671v-6m6 5v-6m6 5v-6m6 6v-6"/></g>
    <g class="border-dots" fill="#df9e62" stroke="none">{[[20,678],[218,704],[226,706],[361,704],[578,698],[607,706],[829,706],[1004,700]].map(([x,y],i)=><circle cx={x} cy={y} r={i%2 ? 1.1 : 1.7}/>)}</g>
  </g>}
  {theme==='relationships'&&<g stroke={`url(#${ink})`} stroke-width="1.2">
    {/* Separate segments meet the wrists and bubble edges, never cross the drawings. */}
    <path class="relationship-baseline" d="M18 659v17q0 20 28 20C64 696 80 691 96 691M130 691l13 3m30 1 12-3M216 685C242 680 260 684 276 690M392 690C420 690 444 690 471 690S514 693 541 695S579 703 610 697S660 684 699 691S754 702 791 696S841 685 879 691S928 699 961 695S1011 697 1042 694Q1062 693 1062 677V656"/>
    <path d="M18 636v15m1044-15v15" stroke-dasharray="1 6"/>
    <g class="border-conversation" transform="translate(113 685)"><path d="M-15 0q0-10 15-10t15 10q0 9-10 9l-7-2-6 4 1-5q-8-1-8-6Z"/>{[-7,0,7].map(x=><circle cx={x} cy="0" r="1" fill="#ecc58c"/>)}</g>
    <g transform="translate(159 688) scale(.88)"><path d="M-15 0q0-10 15-10t15 10q0 9-10 9l-7-2-6 4 1-5q-8-1-8-6Z"/>{[-6,0,6].map(x=><circle cx={x} cy="0" r="1" fill="#ecc58c"/>)}</g>
    <g transform="translate(201 679) scale(.88)"><path d="M-15 0q0-10 15-10t15 10q0 9-10 9l-7-2-6 4 1-5q-8-1-8-6Z"/>{[-6,0,6].map(x=><circle cx={x} cy="0" r="1" fill="#ecc58c"/>)}</g>
    <g class="relationship-hands" stroke-width="1.15">
      <path d="M276 687c12-1 23-6 32-8l10-7q3-2 3 1l-7 8 13-2q4 0 2 3l-11 4 12-1q3 1 0 3l-11 2 10-1q3 2-1 3l-11 2 7-1q3 2-1 3l-9 1q-8 0-15-4l-23 1Z"/>
      <path d="M299 682v10m18-6-7 1m9 3-8 1"/>
      <g transform="translate(668 0) scale(-1 1)"><path d="M276 687c12-1 23-6 32-8l10-7q3-2 3 1l-7 8 13-2q4 0 2 3l-11 4 12-1q3 1 0 3l-11 2 10-1q3 2-1 3l-11 2 7-1q3 2-1 3l-9 1q-8 0-15-4l-23 1Z"/><path d="M299 682v10m18-6-7 1m9 3-8 1"/></g>
    </g>
    <g stroke-width=".6"><ellipse cx="522" cy="695" rx="12" ry="3.4" fill="#e9b58b"/><ellipse cx="551" cy="690" rx="12" ry="3.4" fill="#a6a781"/><ellipse cx="580" cy="698" rx="12" ry="3.4" fill="#e9be79"/></g>
    <g class="border-balance" transform="translate(1034 682)" stroke="#b56c43"><path d="M0-16v25m-8 2H8m-21-23h26M-10-10l-7 14h14l-7-14m20 0L3 4h14l-7-14"/><circle cy="-16" r="1.7" fill="#ce8d59"/></g>
    <g class="border-dots" fill="#dea267" stroke="none">{[[58,689],[244,693],[403,689],[483,692],[632,692],[724,689],[842,692],[942,688]].map(([x,y],i)=><circle cx={x} cy={y} r={i%2 ? 1.3 : 1.8}/>)}</g>
    <g fill="#e9bb86" stroke="none"><path d="M25 680q-10-3-11-12 10 1 11 12Zm1-5q-3-11 3-17 6 10-3 17Zm3 6q4-10 12-9-1 8-12 9Z"/><path d="M1056 691q-10-3-11-12 10 1 11 12Zm1-5q-3-11 3-17 6 10-3 17Zm3 6q4-10 12-9-1 8-12 9Z"/></g>
  </g>}
  {theme==='future'&&<g stroke="#b46c46" stroke-width="1.2">
    <path d="M18 649v27q0 22 29 22h11"/>
    <path d="M58 698C90 682 125 687 155 695S214 705 247 695S298 686 331 694S383 701 416 695" stroke-dasharray="2 4"/>
    <path d="M416 695h34v-7h14v-7h14v-7h18v7h18v7h20v7h31C602 695 615 702 645 702H690m250 0h102q20 0 20-23v-30"/>
    <g transform="translate(34 679)"><path d="M0 10v-25q6-5 12 0v12Q6-8 0-3"/><path d="M0-13q6-4 12 0" stroke="#edc18b"/></g>
    <g fill="#fff7e9" stroke-width="1.5"><circle cx="100" cy="688" r="3"/><circle cx="247" cy="695" r="3" stroke="#7d8a5e"/><circle cx="397" cy="697" r="3" fill="#efc28f"/></g>
    <path d="M690 702h25m208 0h17" stroke-dasharray="2 4"/>
    <g stroke-width="1.6">{[5,9,14,20,12,7,4,8,16,24,16,10,5,8,14,19,12,5].map((h,i)=><path class="border-sound" style={'animation-delay:'+i*.12+'s'} stroke={i%3===0 ? '#a0a17b' : i%3===1 ? '#dba76b' : '#b46c46'} d={`M${722+i*10} ${699-h/2}v${h}`}/>)}</g>
    <g transform="translate(1032 683)"><rect x="-4" y="-19" width="8" height="17" rx="4"/><path d="M-7-10v5a7 7 0 0 0 14 0v-5M0 2v8m-6 1H6m-8-24h4m-4 4h4"/></g>
    <g class="border-dots" stroke="#d29b5e"><path d="m67 666 2-4 2 4-2 4-2-4Zm598 22 3-4 3 4-3 4-3-4Zm382-34 2-4 2 4-2 4-2-4Z"/></g>
  </g>}
</g>
<style is:global>
  .border-dots,.border-glint{animation:edge-ink 5s ease-in-out infinite}
  .border-conversation{transform-box:fill-box;transform-origin:center;animation:border-talk 4.8s ease-in-out infinite}
  .border-balance{transform-box:fill-box;transform-origin:top center;animation:border-balance 6s ease-in-out infinite}
  .border-sound{transform-box:fill-box;transform-origin:center;animation:edge-voice 2.3s ease-in-out infinite}
  @keyframes border-talk{0%,100%{opacity:.65}50%{opacity:1}}
  @keyframes border-balance{0%,100%{opacity:.75}50%{opacity:1}}
</style>
