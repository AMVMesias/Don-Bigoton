---
import SceneCat from './SceneCat.astro';
interface Props { kind:'cat'|'burger'|'delivery'; }
const {kind}=Astro.props;
const label=kind==='burger'?'Una hamburguesa ilustrada se arma por capas.':kind==='delivery'?'Un gato camina hacia una bolsa de pedidos, la observa y se acuesta a su lado.':'Un gato naranja camina hacia una hamburguesa, la olfatea y se acuesta junto a ella.';
---
<figure class={`kitchen-scene scene-${kind}`} role="img" aria-label={label}>
  <svg viewBox="0 0 520 230" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <path d="M18 198h484" stroke="#a8784d" stroke-width="1" opacity=".3"/>
    {kind==='burger'?<g class="assembly-art" stroke="#593c2b" stroke-width="2.5" stroke-linejoin="round">
      <ellipse cx="266" cy="200" rx="108" ry="9" fill="#e0c8a3" stroke="none"/>
      <path d="M163 191q103 28 206 0" stroke="#a8784d" fill="none"/>
      <g class="burger-layer burger-bottom"><path d="M192 168h148v9c0 24-148 24-148 0Z" fill="#eca558"/><path d="M204 178h124" stroke="#d48642"/></g>
      <g class="burger-layer burger-patty"><rect x="187" y="148" width="158" height="23" rx="11" fill="#754431"/><path d="m205 157 8 4m25-5 9 4m42-4 10 4m22-4 8 4" stroke="#a46b46"/></g>
      <g class="burger-layer burger-cheese"><path d="m190 137 34-6 100 4 17 11-33-1-23 14-18-14-35 4-15-8-27 4Z" fill="#f4c54f"/></g>
      <g class="burger-layer burger-greens"><path d="M188 123q12-15 25-2 15-14 28-1 12-15 28-1 15-13 29 0 17-11 29 1 12-8 18 8l-16 8-21-4-21 6-20-6-23 5-23-7-20 6Z" fill="#91a365"/></g>
      <g class="burger-layer burger-top"><path d="M190 119c-2-69 154-69 152 0Z" fill="#eda55b"/><path d="m219 94 4-3m19-7 3 3m20-6 3-2m21 8 4 1m18 12 3-3" stroke="#fff4d7" stroke-width="3" stroke-linecap="round"/></g>
      <g class="assembly-spark" stroke="#b6783e" stroke-linecap="round"><path d="M150 86v18m-9-9h18M382 112v15m-7-7h14m-12-56-8 8"/></g>
    </g>:<>
      {kind==='delivery'?<g class="scene-order" stroke="#593c2b" stroke-width="2.5" stroke-linejoin="round"><path d="m367 94-7 100h93l-6-100Z" fill="#dcb17c"/><path d="M386 98V81c0-28 39-28 39 0v17" stroke="#a5784e" stroke-width="5"/><path d="m374 105 9 8h45l12-8" stroke="#b98b56"/><path d="m388 133-1-13 13 8h13l13-8-1 14c10 19-4 28-19 28s-28-11-18-29Z" fill="#ef9851"/><path d="m395 141 4 3m15-3 4 3m-12 7h1" stroke="#593c2b" stroke-width="2"/><path d="M382 176h49" stroke="#b98b56"/></g>:<g class="scene-meal" stroke="#593c2b" stroke-width="2.2" stroke-linejoin="round"><ellipse cx="405" cy="194" rx="62" ry="8" fill="#ead6b3" stroke="none"/><path d="M355 163h98v13c0 21-98 21-98 0Z" fill="#eaa158"/><rect x="352" y="149" width="104" height="16" rx="8" fill="#764633"/><path d="m351 144 18-6 13 6 17-5 18 6 16-5 21 7-15 7-18-4-17 8-16-8-19 5Z" fill="#93a66c"/><path d="M355 139c0-45 98-45 98 0Z" fill="#efa960"/><path d="m377 121 3-2m19-3 3 2m18 5 4-1" stroke="#fff7e9" stroke-width="3" stroke-linecap="round"/></g>}
      <g transform="translate(0 89)"><SceneCat/></g>
      <g class="scene-sniff-lines" stroke="#ba8154" stroke-width="2" stroke-linecap="round"><path d="m347 137 10-5m-9 15 12 1m-14 8 9 7"/></g>
    </>}
  </svg>
  <figcaption>{kind==='burger'?'ILUSTRACIÓN EDITORIAL · EL SABOR SE CONSTRUYE':kind==='delivery'?'EL GERENTE SUPERVISA… Y DESPUÉS DESCANSA.':'CAMINAR · OLFATEAR · ACOMODARSE · DESCANSAR'}</figcaption>
</figure>
