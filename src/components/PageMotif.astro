---
import { pageMotifs } from '../data/page-motifs';
interface Props { number:number; preview?:boolean; }
const {number,preview=false}=Astro.props;
const motif=pageMotifs[number-1] || pageMotifs[0];
---
<svg class={`page-motif motif-${motif.motion}${preview?' motif-preview':''}`} viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <g class="motif-drawing">{motif.paths.map(path=><path d={path}/>)}</g>
  <circle class="motif-dot" cx="89" cy="87" r="2" fill="currentColor" stroke="none"/>
</svg>
